# Raw downloads. Large, and re-fetched by the pipeline.
data/raw/

# R-specific binary, rebuilt from edges.csv in seconds.
data/*.rds

# Model outputs, derivable by re-running the benchmark.
*.npz

# Submission artefacts: 600 dpi TIFF and EPS are regenerated by
# R/03_figures.R and R/00_figure1_design.R. PDF (vector) and PNG are
# tracked so the figures can be viewed without running anything.
results/figures/*.tiff
results/figures/*.eps

# The Open Targets intermediates (data/disease_assoc.csv,
# data/tractability.csv) and the derived interactome (data/edges.csv,
# data/nodes_topology.csv) ARE tracked, deliberately. Open Targets and
# STRING both update, so without the pinned copies a later re-run would
# not reproduce the reported numbers.

# R
.Rhistory
.RData
.Rproj.user/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
venv/
.venv/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Logs
*.log
nohup.out
